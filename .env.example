# DHATRI (धात्री) — Environment Configuration Template
# Copy this file to .env and configure your values

# Server Settings
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database
# Local MongoDB is used by default. An automated file-based fallback store is also
# provided if MongoDB service is stopped.
MONGODB_URI=mongodb://127.0.0.1:27017/dhatri

# Security & Authentication
JWT_SECRET=your_long_random_jwt_secret_token_here_change_in_production
JWT_EXPIRES_IN=7d

# AI Wellness Assistant Configuration
# Supported providers: "gemini" | "openai" | "mock"
# If no API key is provided, Dhatri runs on its high-fidelity clinical assistant engine
# and clearly indicates the configuration status in the UI without faking live LLM calls.
AI_PROVIDER=gemini

# Google Gemini API Key (Recommended - Free Tier Available)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Get a key at: https://platform.openai.com/
OPENAI_API_KEY=
